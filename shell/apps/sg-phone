STAGE_W = 405          # reference-canvas width of the phone column (354 px phone + 51 px margin)
DRAFTS = C.DATA_DIR / "drafts"
PHONE_DIR = C.DATA_DIR / "phone"
PREFS = PHONE_DIR / "prefs.json"
WALLPAPERS = PHONE_DIR / "wallpapers"        # the owner's pictures for the phone's home screen
RINGTONES = PHONE_DIR / "ringtones"          # the owner's ringtones (mail, calls)
SOUND_PACK = C.DATA_DIR / "sounds" / "pack"  # optional event sounds: phone_open, phone_close, mail, call, key
