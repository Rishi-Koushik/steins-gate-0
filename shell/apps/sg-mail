#!/usr/bin/python3 -I
"""Put a mail into the Phone Trigger's inbox.

  sg-mail send FROM SUBJECT [BODY]     a mail from anyone (scripts, cron jobs …)
  sg-mail event NAME [DETAIL]          a contact reacts: login, build-failed, battery-low
  sg-mail list                         what is in the inbox
"""
import sys
import time
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))

import sg_mailbox as M


def main(argv):
    if len(argv) >= 3 and argv[0] == "send":
        print(M.send(argv[1], argv[2], argv[3] if len(argv) > 3 else ""))
    elif len(argv) >= 2 and argv[0] == "event":
        mail_id = M.event(argv[1], argv[2] if len(argv) > 2 else "")
        print(mail_id or "no mail (unknown event, contact not in the list, cooling down, or switched off)")
    elif argv[:1] == ["list"]:
        for m in M.listing():
            print(f"{'  ' if m['read'] else '● '}{time.strftime('%m.%d %H:%M', time.localtime(m['ts']))}  "
                  f"{m['from'][:14]:14}  {m['subject']}")
    else:
        sys.stderr.write(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
