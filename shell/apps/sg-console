#!/usr/bin/python3 -I
"""SG console: a plain terminal window (VTE) with a translucent background.

  sg-console                 toggle (Super+C): show / focus / hide
  sg-console --show | --hide
  sg-console --fullscreen    toggle full screen (F11)
  sg-console --new-tab       open a new tab (Ctrl+Shift+T)

It runs your normal shell with your normal environment, so what you type and what you
get back is the same as in any other terminal. Hiding the window keeps the shells running.
"""
import os
import re
import shlex
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))

import sg_common as C

APP_ID = "local.amadeus.SgTerminal"
TOKEN_ARG = "--activation-token="

# A shortcut press starts a new process; pass its focus token on to the running console
# so the compositor lets the window come to the front.
_token = os.environ.get("XDG_ACTIVATION_TOKEN") or os.environ.get("DESKTOP_STARTUP_ID")
ARGV = sys.argv + ([TOKEN_ARG + _token] if _token else [])
C.forward_to_running(APP_ID, ARGV)

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Vte", "3.91")
from gi.repository import Gtk, Gdk, Gio, GLib, Vte, Pango

