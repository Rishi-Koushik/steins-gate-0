def rgba(spec, alpha=None):
    c = Gdk.RGBA()
    if not c.parse(spec):
        c.parse("#081614")
    if alpha is not None:
        c.alpha = alpha
    return c


class ConsoleTab:
    """One terminal running its own shell."""

    def __init__(self, console, tab_id):
        self.console = console
        self.tab_id = tab_id
        self.last_url = None
        cfg = console.cfg

        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, hexpand=True, vexpand=True)
        self.term = Vte.Terminal(hexpand=True, vexpand=True)
        # the window paints the translucent background; the terminal itself stays clear
        self.term.set_clear_background(False)
        self.term.set_colors(rgba("#ffffff"), rgba("#000000", 0.0), [rgba(c) for c in PALETTE])
        self.term.set_color_bold(None)
        font = C.cfg_get(cfg, "console", "font", "")
        if not font:
            try:
                font = Gio.Settings.new("org.gnome.desktop.interface").get_string("monospace-font-name")
            except Exception:
                font = "Monospace 11"
        self.term.set_font(Pango.FontDescription.from_string(font))
        self.base_scale = float(C.cfg_get(cfg, "console", "font_scale", 1.0))
        self.term.set_font_scale(self.base_scale)
        self.term.set_scrollback_lines(int(C.cfg_get(cfg, "console", "scrollback", 10000)))
        self.term.set_cursor_blink_mode(Vte.CursorBlinkMode.SYSTEM)
        self.term.set_mouse_autohide(True)
        self.term.set_allow_hyperlink(True)
        self.box.append(self.term)

        self.scroll = Gtk.Scrollbar(orientation=Gtk.Orientation.VERTICAL)
        self.scroll.set_adjustment(self.term.get_vadjustment())
        self.box.append(self.scroll)

        try:
            regex = Vte.Regex.new_for_match(r"(?:https?|ftp|file)://[^\s\"'<>]+", -1, 0x00000400)
            self.term.match_add_regex(regex, 0)
        except Exception:
            pass

        # entry in the tab strip
        self.tab_btn = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.tab_btn.add_css_class("sgcon-tab")
        self.title_label = Gtk.Label(label=f"{tab_id}: ~")
        self.tab_btn.append(self.title_label)
        close_btn = Gtk.Button(label="×", focusable=False)
        close_btn.add_css_class("sgcon-tab-close")
        close_btn.connect("clicked", lambda *_: self.console.close_tab(self))
        self.tab_btn.append(close_btn)
        click_tab = Gtk.GestureClick()
        click_tab.connect("pressed", lambda *_: self.console.set_active_tab(self))
        self.tab_btn.add_controller(click_tab)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.term.add_controller(keys)
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self.on_motion)
        self.term.add_controller(motion)
        click = Gtk.GestureClick()
        click.set_button(0)
        click.connect("pressed", self.on_click)
        self.term.add_controller(click)
        scroll_ctrl = Gtk.EventControllerScroll.new(Gtk.EventControllerScrollFlags.VERTICAL)
        scroll_ctrl.connect("scroll", self.on_scroll)
        self.term.add_controller(scroll_ctrl)
        drop = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
        drop.connect("drop", self.on_drop)
        self.term.add_controller(drop)

        self.term.connect("child-exited", lambda *_: self.console.on_child_exited(self))
        self.term.connect("window-title-changed", self.on_title_changed)
        self.spawn()

    def spawn(self):
        """The user's own shell, started the way any terminal starts it: no rc file of ours,
        no banner, no prompt change. VTE sets TERM / COLORTERM itself."""
        cfg = self.console.cfg
        shell = C.cfg_get(cfg, "console", "shell", "") or os.environ.get("SHELL") or "/bin/bash"
        env = dict(os.environ)
        for k in ("XDG_ACTIVATION_TOKEN", "DESKTOP_STARTUP_ID"):
            env.pop(k, None)
        if C.cfg_get(cfg, "console", "extra_commands", True):
            # `lock`, `phone`, `worldline` …: appended last, so they never shadow a real program
            env["PATH"] = env.get("PATH", "/usr/bin") + os.pathsep + str(C.DATA_DIR / "console-bin")
        self.term.spawn_async(Vte.PtyFlags.DEFAULT, str(Path.home()), [shell],
                              [f"{k}={v}" for k, v in env.items()], GLib.SpawnFlags.DEFAULT,
                              None, None, -1, None, None)

    def on_key(self, _ctrl, keyval, _code, state):
        ctrl = Gdk.ModifierType.CONTROL_MASK
        shift = Gdk.ModifierType.SHIFT_MASK
        alt = Gdk.ModifierType.ALT_MASK
        mods = state & (ctrl | shift | alt)
        con = self.console

        if keyval == Gdk.KEY_F11 and not mods:
            con.toggle_fullscreen()
            return True

        if mods == (ctrl | shift):
            if keyval in (Gdk.KEY_C, Gdk.KEY_c):
                self.term.copy_clipboard_format(Vte.Format.TEXT)
            elif keyval in (Gdk.KEY_V, Gdk.KEY_v):
                self.term.paste_clipboard()
            elif keyval in (Gdk.KEY_A, Gdk.KEY_a):
                self.term.select_all()
            elif keyval in (Gdk.KEY_T, Gdk.KEY_t):
                con.new_tab()
            elif keyval in (Gdk.KEY_W, Gdk.KEY_w):
                con.close_tab(self)
            elif keyval in (Gdk.KEY_F, Gdk.KEY_f):
                con.toggle_search()
            elif keyval in (Gdk.KEY_ISO_Left_Tab, Gdk.KEY_Tab):
                con.prev_tab()
            elif keyval in (Gdk.KEY_plus, Gdk.KEY_equal):
                self.zoom(1.1)
            else:
                return False
            return True

        if mods == ctrl:
            if keyval == Gdk.KEY_Page_Up:
                con.prev_tab()
            elif keyval in (Gdk.KEY_Page_Down, Gdk.KEY_Tab):
                con.next_tab()
            elif keyval in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
                self.zoom(1.1)
            elif keyval in (Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
                self.zoom(1.0 / 1.1)
            elif keyval in (Gdk.KEY_0, Gdk.KEY_KP_0):
                self.term.set_font_scale(self.base_scale)
            else:
                return False
            return True

        if mods == alt and Gdk.KEY_1 <= keyval <= Gdk.KEY_9 and len(con.tabs) > 1:
            con.switch_to_tab_index(keyval - Gdk.KEY_1)
            return True
        return False

    def url_at(self, x, y):
        url = self.term.check_hyperlink_at(x, y)
        if not url:
            m = self.term.check_match_at(x, y)
            if m and m[0]:
                url = m[0]
        return url

    def on_motion(self, _ctrl, x, y):
        self.last_url = self.url_at(x, y)

    def on_click(self, gesture, _n_press, x, y):
        btn = gesture.get_current_button()
        if btn == 1:
            state = gesture.get_current_event_state()
            if (state & Gdk.ModifierType.CONTROL_MASK) and self.last_url:
                try:
                    Gio.AppInfo.launch_default_for_uri(self.last_url, None)
                    gesture.set_state(Gtk.EventSequenceState.CLAIMED)
                except Exception:
                    pass
        elif btn == 3:
            # leave the right button to programs that asked for the mouse (vim, htop …) unless Shift is held
            self.console.show_context_menu(self, x, y)
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)

    def on_scroll(self, ctrl, _dx, dy):
        if ctrl.get_current_event_state() & Gdk.ModifierType.CONTROL_MASK:
            self.zoom(1.1 if dy < 0 else 1.0 / 1.1)
            return True
        return False

    def on_drop(self, _target, value, _x, _y):
        paths = [f.get_path() for f in value.get_files() if f.get_path()]
        if not paths:
            return False
        self.term.feed_child((" ".join(shlex.quote(p) for p in paths) + " ").encode())
        return True

    def zoom(self, factor):
        self.term.set_font_scale(max(0.5, min(4.0, self.term.get_font_scale() * factor)))

    def on_title_changed(self, _term):
        raw = (self.term.props.window_title or "").strip()
        part = raw.split(": ")[-1].strip() if raw else "shell"
        if len(part) > 22:
            part = "…" + part[-21:]
        self.title_label.set_label(f"{self.tab_id}: {part}")
        self.console.update_title()


class Console(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None
        self.cfg = C.load_config()
        self.tabs = []
        self.active_tab = None
        self.tab_seq = 1
        self.popover = None

    # ---- command line (also arrives here from later `sg-console` runs) ----
    def do_command_line(self, cl):
        args = cl.get_arguments()[1:]
        token = next((a[len(TOKEN_ARG):] for a in args if a.startswith(TOKEN_ARG)), None)
        args = [a for a in args if not a.startswith(TOKEN_ARG)]
        op = args[0].lstrip("-") if args else "toggle"
        if op not in ("toggle", "show", "hide", "fullscreen", "new-tab", "tab"):
            cl.printerr_literal(__doc__)
            if self.win is None:
                self.quit()
            return 0 if op in ("h", "help") else 2

        first = self.win is None
        if first:
            self.build()
        if op == "toggle":
            # hidden → show; shown but behind something → bring forward; in front → hide
            self.set_shown(first or not self.win.get_visible() or not self.win.is_active(), token)
        elif op == "hide":
            self.set_shown(False)
        else:
            if op == "fullscreen" and not first:
                self.toggle_fullscreen()
            elif op in ("new-tab", "tab") and not first:
                self.new_tab()
            self.set_shown(True, token)
        return 0

    # ---- UI ----
    def build(self):
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
        bg = rgba(str(C.cfg_get(self.cfg, "console", "background", "#081614")))
        opacity = max(0.0, min(1.0, float(C.cfg_get(self.cfg, "console", "opacity", 0.80))))
        css = Gtk.CssProvider()
        css.load_from_string(CSS % {"r": round(bg.red * 255), "g": round(bg.green * 255),
                                    "b": round(bg.blue * 255), "a": opacity})
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.win = Gtk.ApplicationWindow(application=self, title="Console")
        self.win.add_css_class("sgcon")
        self.win.set_default_size(int(C.cfg_get(self.cfg, "console", "width", 1100)),
                                  int(C.cfg_get(self.cfg, "console", "height", 680)))
        # closing only hides: the shells keep running until `exit`
        self.win.connect("close-request", lambda *_: (self.set_shown(False), True)[1])
        self.win.connect("notify::fullscreened", self.on_fullscreened)

        # Title bar: tabs on the left, new tab + full screen on the right. GTK hides it in full screen.
        bar = Gtk.HeaderBar()
        self.title_label = Gtk.Label(label="Console")
        self.title_label.add_css_class("sgcon-title")
        bar.set_title_widget(self.title_label)
        self.tabs_container = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        bar.pack_start(self.tabs_container)
        self.fs_btn = self.bar_button("⛶", "Full screen (F11)", lambda *_: self.toggle_fullscreen())
        bar.pack_end(self.fs_btn)
        bar.pack_end(self.bar_button("+", "New tab (Ctrl+Shift+T)", lambda *_: self.new_tab()))
        self.win.set_titlebar(bar)

        overlay = Gtk.Overlay()
        self.win.set_child(overlay)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.NONE)
        overlay.set_child(self.stack)
        self.search_box = self.build_search_bar()
        overlay.add_overlay(self.search_box)

        self.new_tab()
        start = str(C.cfg_get(self.cfg, "console", "start", "window"))
        if start == "fullscreen":
            self.win.fullscreen()
        elif start == "maximized":
            self.win.maximize()

    def bar_button(self, label, tip, cb):
        b = Gtk.Button(label=label, tooltip_text=tip, focusable=False, valign=Gtk.Align.CENTER)
        b.add_css_class("sgcon-btn")
        b.connect("clicked", cb)
        return b

    def set_shown(self, shown, token=None):
        if not shown:
            self.win.set_visible(False)
            return
        if token:
            self.win.set_startup_id(token)
        self.win.present()
        if self.active_tab:
            self.active_tab.term.grab_focus()

    def toggle_fullscreen(self):
        if self.win.is_fullscreen():
            self.win.unfullscreen()
        else:
            self.win.fullscreen()

    def on_fullscreened(self, *_):
        self.fs_btn.set_tooltip_text("Leave full screen (F11)" if self.win.is_fullscreen() else "Full screen (F11)")
        if self.active_tab:
            self.active_tab.term.grab_focus()

    def update_title(self):
        t = self.active_tab
        title = (t.term.props.window_title or "").strip() if t else ""
        self.title_label.set_label(title or "Console")
        self.win.set_title(title or "Console")

    # ---- tabs ----
    def new_tab(self):
        tab = ConsoleTab(self, self.tab_seq)
        self.tab_seq += 1
        self.tabs.append(tab)
        self.stack.add_child(tab.box)
        self.tabs_container.append(tab.tab_btn)
        self.set_active_tab(tab)
        return tab

    def set_active_tab(self, tab):
        if tab not in self.tabs:
            return
        self.active_tab = tab
        self.stack.set_visible_child(tab.box)
        for t in self.tabs:
            (t.tab_btn.add_css_class if t is tab else t.tab_btn.remove_css_class)("active")
        # one shell = no tab strip, like a plain terminal
        self.tabs_container.set_visible(len(self.tabs) > 1)
        self.update_title()
        tab.term.grab_focus()
        if self.search_box.get_visible():
            self.on_search_changed(self.search_entry)

    def close_tab(self, tab):
        if tab not in self.tabs:
            return
        idx = self.tabs.index(tab)
        self.tabs.remove(tab)
        self.tabs_container.remove(tab.tab_btn)
        self.stack.remove(tab.box)
        if self.tabs:
            self.set_active_tab(self.tabs[min(idx, len(self.tabs) - 1)])
        else:
            # last shell gone: hide, and have a fresh one ready for the next Super+C
            self.active_tab = None
            self.set_shown(False)
            self.new_tab()

    def on_child_exited(self, tab):
        self.close_tab(tab)

    def step_tab(self, d):
        if len(self.tabs) > 1 and self.active_tab:
            self.set_active_tab(self.tabs[(self.tabs.index(self.active_tab) + d) % len(self.tabs)])

    def prev_tab(self):
        self.step_tab(-1)

    def next_tab(self):
        self.step_tab(1)

    def switch_to_tab_index(self, idx):
        if 0 <= idx < len(self.tabs):
            self.set_active_tab(self.tabs[idx])

    # ---- search (Ctrl+Shift+F) ----
    def build_search_bar(self):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, halign=Gtk.Align.END,
                      valign=Gtk.Align.START, margin_end=24, margin_top=8, visible=False)
        box.add_css_class("sgcon-search-box")
        entry = self.search_entry = Gtk.Entry(placeholder_text="Find…")
        entry.add_css_class("sgcon-search-entry")
        entry.connect("changed", self.on_search_changed)
        key_ctrl = Gtk.EventControllerKey()
        key_ctrl.connect("key-pressed", self.on_search_key)
        entry.add_controller(key_ctrl)
        box.append(entry)
        for label, tip, cb in (("▲", "Previous (Shift+Enter)", lambda *_: self.search_step(False)),
                               ("▼", "Next (Enter)", lambda *_: self.search_step(True)),
                               ("×", "Close (Esc)", lambda *_: self.toggle_search(False))):
            box.append(self.bar_button(label, tip, cb))
        return box

    def on_search_key(self, _ctrl, keyval, _code, state):
        if keyval == Gdk.KEY_Escape:
            self.toggle_search(False)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.search_step(not state & Gdk.ModifierType.SHIFT_MASK)
            return True
        return False

    def on_search_changed(self, entry):
        if not self.active_tab:
            return
        term, text = self.active_tab.term, entry.get_text()
        if not text:
            term.search_set_regex(None, 0)
            return
        try:
            # PCRE2_MULTILINE | PCRE2_CASELESS
            term.search_set_regex(Vte.Regex.new_for_search(re.escape(text), -1, 0x00000400 | 0x00000008), 0)
            term.search_set_wrap_around(True)
            term.search_find_previous()
        except GLib.Error:
            pass

    def search_step(self, forward):
        if self.active_tab:
            t = self.active_tab.term
            (t.search_find_next if forward else t.search_find_previous)()

    def toggle_search(self, force=None):
        show = not self.search_box.get_visible() if force is None else force
        self.search_box.set_visible(show)
        if show:
            self.search_entry.grab_focus()
            self.on_search_changed(self.search_entry)
        elif self.active_tab:
            self.active_tab.term.search_set_regex(None, 0)
            self.active_tab.term.grab_focus()

    # ---- right-click menu ----
    def show_context_menu(self, tab, x, y):
        if self.popover:
            self.popover.unparent()
        popover = self.popover = Gtk.Popover(has_arrow=False)
        popover.add_css_class("sgcon-popover")
        popover.set_parent(tab.term)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)

        def item(label, cb, sensitive=True):
            b = Gtk.Button(label=label, focusable=False, sensitive=sensitive)
            b.get_child().set_xalign(0)
            b.add_css_class("sgcon-menu-item")
            b.connect("clicked", lambda *_: (popover.popdown(), cb()))
            box.append(b)

        def sep():
            s = Gtk.Box()
            s.add_css_class("sgcon-menu-sep")
            box.append(s)

        url = tab.url_at(x, y)
        if url:
            item("Open link", lambda: Gio.AppInfo.launch_default_for_uri(url, None))
            item("Copy link", lambda: Gdk.Display.get_default().get_clipboard().set(url))
            sep()
        item("Copy   Ctrl+Shift+C", lambda: tab.term.copy_clipboard_format(Vte.Format.TEXT),
             tab.term.get_has_selection())
        item("Paste   Ctrl+Shift+V", tab.term.paste_clipboard)
        item("Select all   Ctrl+Shift+A", tab.term.select_all)
        item("Find…   Ctrl+Shift+F", self.toggle_search)
        sep()
        item("New tab   Ctrl+Shift+T", self.new_tab)
        item("Close tab   Ctrl+Shift+W", lambda: self.close_tab(tab))
        sep()
        item("Leave full screen   F11" if self.win.is_fullscreen() else "Full screen   F11", self.toggle_fullscreen)
        item("Hide   Super+C", lambda: self.set_shown(False))

        popover.set_child(box)
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = int(x), int(y), 1, 1
        popover.set_pointing_to(rect)
        popover.popup()


if __name__ == "__main__":
    sys.exit(Console().run(ARGV))
